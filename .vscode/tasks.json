{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rails server",
      "type": "shell",
      "command": "rails s",
      "isBackground": true,
      "problemMatcher": {
        "owner": "rails",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Booting",
          "endsPattern": "Listening on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
