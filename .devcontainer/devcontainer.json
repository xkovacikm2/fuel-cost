{
  "name": "Spotreba Go and Lit",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace/spotreba",
  "features": {
    "ghcr.io/devcontainers-extra/features/go-task:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "runem.lit-plugin",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-containers",
        "cweijan.vscode-database-client2",
        "task.vscode-task"
      ],
      "mcp": {
        "servers": {
          "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/"
          }
        }
      }
    }
  },
  "forwardPorts": [
    8080,
    5173,
    5432,
    "mailpit:8025"
  ],
  "postCreateCommand": {
    "init": "bash .devcontainer/init.sh",
    "gitconfigPermission": "install -m 600 /home/vscode/.gitconfig-copy /home/vscode/.gitconfig"
  },
  "remoteUser": "vscode"
}