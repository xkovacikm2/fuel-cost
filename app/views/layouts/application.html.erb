<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Spotreba" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Spotreba">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#0b3d91">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js" defer></script>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("<%= pwa_service_worker_path %>")
        })
      }
    </script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar-inner" data-controller="navigation">
        <% if authenticated? %>
          <button class="nav-toggle" type="button" data-action="click->navigation#toggle" data-navigation-target="toggle" aria-controls="main-navigation" aria-expanded="false" aria-label="Otvoriť navigáciu" title="Otvoriť navigáciu">
            <%= image_tag "/icons/menu.svg", alt: "", aria: { hidden: true } %>
          </button>
        <% end %>
        <h1 class="brand"><%= link_to "Spotreba", root_path %></h1>
        <% if authenticated? %>
          <nav id="main-navigation" class="main-nav" data-navigation-target="menu">
            <button class="nav-expand" type="button" data-action="click->navigation#expand" data-navigation-target="expand" aria-expanded="false" aria-label="Rozšíriť navigáciu" title="Rozšíriť navigáciu">
              <%= image_tag "/icons/chevron-right.svg", alt: "", aria: { hidden: true } %>
              <span>Rozšíriť navigáciu</span>
            </button>
            <%= link_to root_path, class: "nav-link", title: "Prehľad" do %>
              <%= image_tag "/icons/home.svg", alt: "", aria: { hidden: true } %>
              <span>Prehľad</span>
            <% end %>
            <%= link_to new_refueling_path, class: "nav-link", title: "Nové tankovanie" do %>
              <%= image_tag "/icons/fuel.svg", alt: "", aria: { hidden: true } %>
              <span>Nové tankovanie</span>
            <% end %>
            <%= link_to new_additional_cost_path, class: "nav-link", title: "Dodatočné náklady" do %>
              <%= image_tag "/icons/receipt.svg", alt: "", aria: { hidden: true } %>
              <span>Dodatočné náklady</span>
            <% end %>
            <%= link_to maintenance_reminders_path, class: "nav-link", title: "Pripomienky" do %>
              <%= image_tag "/icons/bell.svg", alt: "", aria: { hidden: true } %>
              <span>Pripomienky</span>
            <% end %>
            <%= link_to vehicles_path, class: "nav-link", title: "Vozidlá" do %>
              <%= image_tag "/icons/car.svg", alt: "", aria: { hidden: true } %>
              <span>Vozidlá</span>
            <% end %>
            <div class="user-menu" data-controller="user-menu" data-action="click@window->user-menu#closeOutside keydown.esc@window->user-menu#escape turbo:before-cache@document->user-menu#reset navigation:closed->user-menu#reset">
              <button type="button" class="link-button nav-link" title="Používateľ" aria-controls="user-menu-panel" aria-expanded="false" data-user-menu-target="toggle" data-action="user-menu#toggle">
                <%= image_tag "/icons/user.svg", alt: "", aria: { hidden: true } %>
                <span>Používateľ</span>
              </button>
              <div id="user-menu-panel" class="user-menu-panel" data-user-menu-target="panel" hidden>
                <%= link_to export_user_data_path, class: "nav-link", title: "Exportovať JSON", data: { turbo: false, action: "user-menu#close" } do %>
                  <%= image_tag "/icons/download.svg", alt: "", aria: { hidden: true } %>
                  <span>Exportovať JSON</span>
                <% end %>
                <%= form_with url: import_user_data_path, multipart: true, data: { user_menu_target: "form", action: "submit->user-menu#busy turbo:submit-end->user-menu#reset" } do |form| %>
                  <%= form.file_field :file, accept: ".json,application/json", required: true, hidden: true, aria: { label: "JSON súbor na import" }, data: { user_menu_target: "file", action: "change->user-menu#upload" } %>
                  <button type="button" class="link-button nav-link" title="Importovať JSON" data-user-menu-target="importButton" data-action="user-menu#chooseFile">
                    <%= image_tag "/icons/upload.svg", alt: "", aria: { hidden: true } %>
                    <span>Importovať JSON</span>
                  </button>
                <% end %>
                <%= button_to session_path, method: :delete, class: "link-button nav-link", title: "Odhlásiť sa" do %>
                  <%= image_tag "/icons/logout.svg", alt: "", aria: { hidden: true } %>
                  <span>Odhlásiť sa</span>
                <% end %>
              </div>
            </div>
          </nav>
        <% else %>
          <nav class="main-nav">
            <%= link_to "Prihlásiť sa", new_session_path %>
            <%= link_to "Vytvoriť účet", sign_up_path %>
          </nav>
        <% end %>
      </div>
    </header>

    <main class="container page">
      <% if flash[:notice] %>
        <p class="flash flash-notice"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p class="flash flash-alert"><%= flash[:alert] %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
