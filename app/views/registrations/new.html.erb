<% content_for :title, "Vytvoriť účet" %>

<section class="card">
	<h2>Vytvoriť účet</h2>
	<p class="muted">Registrácia je otvorená. Na začiatok sledovania spotreby paliva použite e-mail a heslo.</p>

	<%= form_with model: @user, url: registration_path do |form| %>
		<% if @user.errors.any? %>
			<div class="errors">
				<strong>Pri vytváraní účtu sa vyskytli chyby:</strong>
				<ul>
					<% @user.errors.each do |error| %>
						<li><%= error.full_message %></li>
					<% end %>
				</ul>
			</div>
		<% end %>

		<div class="field">
			<%= form.label :email_address, "E-mail" %>
			<%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
		</div>

		<div class="field">
			<%= form.label :password, "Heslo" %>
			<%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
		</div>

		<div class="field">
			<%= form.label :password_confirmation, "Potvrdenie hesla" %>
			<%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
		</div>

		<div class="actions">
			<%= form.submit "Vytvoriť účet" %>
			<%= link_to "Už máte účet? Prihláste sa.", new_session_path, class: "button secondary" %>
		</div>
	<% end %>
</section>
