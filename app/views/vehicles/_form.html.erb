<%= form_with(model: vehicle) do |form| %>
  <% if vehicle.errors.any? %>
    <div class="errors">
      <h2>Toto vozidlo sa nepodarilo uložiť:</h2>

      <ul>
        <% vehicle.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Názov vozidla" %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :fuel_type, "Typ paliva" %>
    <%= form.select :fuel_type, Vehicle.fuel_type_options %>
  </div>

  <div class="actions">
	    <%= form.submit "Uložiť" %>
	    <%= link_to "Späť", vehicles_path, class: "button secondary" %>
  </div>
<% end %>
